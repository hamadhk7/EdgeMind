{
  "name": "edgemind",
  "version": "0.1.0",
  "description": "Multi-agent AI backend on Cloudflare edge: Agents SDK, Durable Objects, Queues, Workflows, AI Gateway, Vectorize, D1, R2, KV",
  "scripts": {
    "dev": "wrangler dev",
    "dev:offline": "node scripts/dev-offline.mjs",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply edgemind-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply edgemind-db --remote",
    "setup": "bash scripts/setup.sh",
    "smoke": "node scripts/smoke.mjs"
  },
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "agents": "^0.24.0",
    "hono": "^4.13.12",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.146.0"
  },
  "private": true
}
